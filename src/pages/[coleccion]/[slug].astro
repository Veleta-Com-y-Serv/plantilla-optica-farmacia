---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «enfoque»: banda azul noche con migas y título con la última palabra en menta, la foto a la derecha con
// un marco fino (o, sin foto, un icono grande en lente); banda blanca con el `detalle` y, al lado, la tabla de
// datos con líneas finas y la caja azul de cita; franja de fotos (`imagenes`) a sangre; y otros servicios de la
// misma lista en banda azul suave, con líneas finas en lugar de tarjetas.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { partirTitulo, seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const [inicio, final] = partirTitulo(f.titulo);
const c = site.contacto;
const cita = seccion('cita') ? enlace('/#cita') : site.boton_cabecera?.url || enlace('/#contacto');
const textoCita = site.boton_cabecera?.texto || 'Pedir cita';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--noche ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{inicio}<span class="resalte">{final}</span></h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec btn-sec--claro" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span class="ficha-lente"><Icono nombre={f.icono || 'ojo'} tam={88} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--clara banda--ritmo">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio-dato">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda--azul">
          <p class="ficha-cita-titulo">¿Lo vemos en el mostrador?</p>
          <p>Te lo explicamos con calma, sin compromiso de compra.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section aria-label={`Fotos de ${f.titulo}`}>
      <ul class="franja-fotos" style={`--n:${Math.min(f.imagenes.length, 4)}`}>
        {f.imagenes.map((src, i) => (
          <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={1000} /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--suave banda--ritmo">
      <div class="contenedor">
        <Titular partido antetitulo={nombreSeccion} titulo={`Otros ${f.def.nombre.toLowerCase()}s`} />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="icono-lente"><Icono nombre={o.icono || 'ojo'} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio-dato">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los {f.def.nombre.toLowerCase()}s</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.25rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: var(--c-acento); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.3rem, 6vw, 4.5rem); overflow-wrap: anywhere; max-width: 16ch; }
  .ficha-precio { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.4rem; color: var(--c-acento); }
  .ficha-precio-dato { font-family: var(--fuente-titulos); font-weight: 800; color: var(--c-primario); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; background: color-mix(in srgb, var(--c-primario) 40%, #000); box-shadow: 0 0 0 2px rgb(255 255 255 / .85), 0 30px 80px -30px rgb(0 0 0 / .6); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--radio); border: 1px solid rgb(255 255 255 / .2); }
  .ficha-lente { display: grid; place-items: center; width: 10rem; height: 10rem; border-radius: 50%; border: 2px solid rgb(255 255 255 / .9); color: #fff; position: relative; }
  .ficha-lente::after { content: ""; position: absolute; top: .4rem; right: .6rem; width: .9rem; height: .9rem; border-radius: 50%; background: var(--c-acento); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; padding-bottom: .9rem; border-bottom: 2px solid var(--c-acento); }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; border-radius: var(--radio); padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: #fff; text-decoration: none; }
  .ficha-otras { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); column-gap: 2.5rem; }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding-block: 2rem; border-top: 1px solid var(--linea); }
  .ficha-otra .icono-lente { margin-bottom: .25rem; }
  .ficha-otra h3 { font-size: 1.25rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-primario); outline-offset: 2px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; color: var(--c-primario); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
